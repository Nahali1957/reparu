COMPOSE_PROJECT_NAME=reparu

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=reparu
MYSQL_USER=reparu
MYSQL_PASSWORD=change-me

# Backend
JWT_SECRET=change-me-long-random-string
CORS_ORIGINS=https://localhost:5180
# Nom d'hôte (ou IP) par lequel on accède à l'application ; le certificat TLS interne est émis pour ce nom
REPARU_HOST=localhost
DEMO_PASSWORD=change-me-demo

# MQTT
MQTT_BACKEND_PASSWORD=change-me-mqtt
MQTT_SENSOR_PASSWORD=change-me-sensor
IOT_CAPTEURS=iot-cap-001,iot-cap-002,iot-cap-003,iot-cap-004,iot-cap-005,iot-cap-006
# Période de remontée des capteurs : 21600 s (6 h) en production, accélérée en démo
IOT_PERIODE_S=120
# Capteurs volontairement silencieux (simulation de panne)
IOT_CAPTEURS_MUETS=iot-cap-006
